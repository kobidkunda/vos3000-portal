# Core
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000,http://localhost:8080
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_NAME=VOS Portal
NEXT_PUBLIC_ENVIRONMENT_NAME=Development
SESSION_SECRET=change-me-use-32-plus-random-bytes
AUTH_MODE=demo
DATA_MODE=demo
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=2000000
API_IP_RATE_LIMIT_PER_MINUTE=600
API_KEY_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW_SECONDS=3600
SESSION_TTL_SECONDS=43200
REALTIME_STALE_MS=15000

# Demo users (development only; production rejects AUTH_MODE=demo and DATA_MODE=demo)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_CLIENT_EMAIL=client@example.com
DEMO_CLIENT_PASSWORD=Client123!

# PostgreSQL
DATABASE_URL=postgres://vos:vos@postgres:5432/vos_portal
PG_POOL_MAX=20

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vos
CLICKHOUSE_REQUEST_TIMEOUT_MS=15000

# Redis
REDIS_URL=redis://redis:6379

# Redpanda
REDPANDA_BROKERS=redpanda:9092

# Internal CDR ingest (shared token; replace in production)
CDR_INGEST_TOKEN=change-me-cdr-ingest-token

# Payment provider & NOWPayments Cryptocurrency Gateway
# Docs: https://nowpayments.io/api
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_PUBLIC_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/nowpayments
PAYMENT_METHODS=crypto_nowpayments
PAYMENT_CREATE_WEBHOOK=
PAYMENT_CREATE_TOKEN=
PAYMENT_CREATE_TIMEOUT_MS=15000
PAYMENT_CONFIRMATION_TOKEN=change-me-payment-confirmation-token

# Secret encryption
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional password-reset delivery adapter
PASSWORD_RESET_DELIVERY_WEBHOOK=
PASSWORD_RESET_DELIVERY_TOKEN=

# VOS integration — see docs/VOS3000_SERVER_SETUP.md for host setup (server.conf 7663/1205/0.0.0.0, e_web_access_control, tomcat 7391)
# Verified lab host: VOS_HTTP_BASE_URL=http://62.84.182.223:7391  VOS_HTTP_USERNAME=admin  VOS_HTTP_PASSWORD=uBECkL320uq2qQj  uuid=bd797894-3f0e-4515-a870-18379afa25b5
VOS_MODE=mock
VOS_HTTP_BASE_URL=
VOS_HTTP_USERNAME=
VOS_HTTP_PASSWORD=
VOS_CAPABILITIES_FILE=/app/config/vos-capabilities.json

# Export storage
EXPORT_DIR=/app/exports
EXPORT_TTL_HOURS=24
WEBHOOK_MAX_ATTEMPTS=8

# Scheduled report delivery adapter. By default recipients must be active organization users.
REPORT_ALLOW_EXTERNAL_RECIPIENTS=false
REPORT_DELIVERY_WEBHOOK=
REPORT_DELIVERY_TOKEN=
REPORT_DELIVERY_TIMEOUT_MS=15000

# Worker/report tuning
WORKER_PG_POOL_MAX=10
MAX_EXPORT_ROWS=5000000
REPORT_QUERY_TIMEOUT_MS=300000
WEBHOOK_TIMEOUT_MS=10000

# Production: use docker-compose.production.yml and private service networks.

# Mark abandoned CREDITING_VOS claims for manual reconciliation; never auto-recredit.
PAYMENT_CREDIT_STALE_MINUTES=5
