{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portal Event Envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "published_at",
    "correlation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "vos_instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
