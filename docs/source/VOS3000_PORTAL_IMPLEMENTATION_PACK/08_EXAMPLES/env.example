# Application
NODE_ENV=development
APP_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=change-in-real-env

# PostgreSQL
DATABASE_URL=postgresql://portal:portal@postgres:5432/portal
PGBOUNCER_URL=postgresql://portal:portal@pgbouncer:6432/portal

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=portal
CLICKHOUSE_USER=portal
CLICKHOUSE_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379

# Redpanda
REDPANDA_BROKERS=redpanda:9092
REDPANDA_CLIENT_ID=vos-portal

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=portal-exports
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me

# VOS
# Do not assume one global VOS forever. Production instances should normally
# be stored in instance registry with protected secret references.
VOS_BOOTSTRAP_HOST=
VOS_BOOTSTRAP_PORT=
VOS_BOOTSTRAP_USER=
VOS_BOOTSTRAP_PASSWORD=

# Payments
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Observability
OTEL_SERVICE_NAME=vos-portal-api
LOG_LEVEL=info
