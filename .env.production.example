NODE_ENV=production
AUTH_MODE=database
DATA_MODE=external
VOS_MODE=http

WEB_URL=https://portal.example.com
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_NAME=VOS Portal
APP_NAME=VOS3000 Portal
NEXT_PUBLIC_ENVIRONMENT_NAME=Production
TRUST_PROXY=true

SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
CDR_INGEST_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN
PAYMENT_CONFIRMATION_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

POSTGRES_USER=vos
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=vos_portal
DATABASE_URL=postgres://vos:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@postgres:5432/vos_portal
PG_POOL_MAX=20
WORKER_PG_POOL_MAX=10

CLICKHOUSE_DATABASE=vos
CLICKHOUSE_USER=vos_portal
CLICKHOUSE_PASSWORD=REPLACE_WITH_STRONG_CLICKHOUSE_PASSWORD
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_REQUEST_TIMEOUT_MS=15000

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379
REDPANDA_BROKERS=redpanda:9092

VOS_HTTP_BASE_URL=https://vos-private.example.internal  # lab: http://62.84.182.223:7391 — see docs/VOS3000_SERVER_SETUP.md
VOS_HTTP_USERNAME=REPLACE  # lab: admin
VOS_HTTP_PASSWORD=REPLACE  # lab: uBECkL320uq2qQj
VOS_CAPABILITIES_FILE=/app/config/vos-capabilities.json

PAYMENT_METHODS=
PAYMENT_CREATE_WEBHOOK=
PAYMENT_CREATE_TOKEN=
PAYMENT_CREATE_TIMEOUT_MS=15000
PASSWORD_RESET_DELIVERY_WEBHOOK=
PASSWORD_RESET_DELIVERY_TOKEN=
REPORT_DELIVERY_WEBHOOK=
REPORT_DELIVERY_TOKEN=
REPORT_DELIVERY_TIMEOUT_MS=15000
REPORT_ALLOW_EXTERNAL_RECIPIENTS=false

EXPORT_DIR=/app/exports
EXPORT_TTL_HOURS=24
MAX_EXPORT_ROWS=5000000
REPORT_QUERY_TIMEOUT_MS=300000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
API_BODY_LIMIT_BYTES=2000000
API_IP_RATE_LIMIT_PER_MINUTE=600
API_KEY_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW_SECONDS=3600
SESSION_TTL_SECONDS=43200
REALTIME_STALE_MS=15000
GATEWAY_PORT=8080

# Mark abandoned CREDITING_VOS claims for manual reconciliation; never auto-recredit.
PAYMENT_CREDIT_STALE_MINUTES=5
